#=============================================================================
# SmarPod hexapod EPICS database
#
# Records expose the SmarPod API. Setpoints and their readbacks share a
# single asyn drvInfo string (the paramdefs generator collapses them into one
# parameter). Multi-component setters (pivot, coordinate system, axes
# orientation, move target) are applied atomically via a dedicated command
# record.
#
# Macros: P, PORT, ADDR, TIMEOUT
#=============================================================================

#---------------------------------------------------------------------------
# Driver / library information
#---------------------------------------------------------------------------
record(stringin, "$(P)DriverVersion_RBV") {
    field(DTYP, "asynOctetRead")
    field(DESC, "Port driver version")
    field(SCAN, "I/O Intr")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SMARPOD_DRIVER_VERSION")
}

record(stringin, "$(P)SDKVersion_RBV") {
    field(DTYP, "asynOctetRead")
    field(DESC, "SmarPod SDK library version")
