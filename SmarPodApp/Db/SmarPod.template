    field(DESC, "Put positioners in standby")
    field(ZNAM, "Done")
    field(ONAM, "Standby")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SMARPOD_STANDBY")
}
record(mbbi, "$(P)MoveStatus_RBV") {
    field(DTYP, "asynInt32")
    field(DESC, "Move status")
    field(ZRVL, "0")
    field(ZRST, "Stopped")
    field(ONVL, "1")
    field(ONST, "Holding")
    field(TWVL, "2")
    field(TWST, "Moving")
    field(THVL, "3")
    field(THST, "Calibrating")
    field(FRVL, "4")
    field(FRST, "Referencing")
    field(FVVL, "5")
    field(FVST, "Standby")
    field(SCAN, "I/O Intr")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SMARPOD_MOVE_STATUS")
}

